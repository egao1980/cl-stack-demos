(in-package #:harness-demos-data)

;;; Demo 3 — sql-orm 0.2.0 schema algebra on SQLite in memory: complete
;;; schema diff, the op fold, alter-column (table rebuild), reflection.

;;; Two versions of the same tables, as models.

(orm:defmodel item-v1 ()
  (id :integer :primary-key t :autoincrement t)
  (name :text :not-null t)
  (qty :integer)
  (legacy :text)
  (:table items))

(orm:defmodel note-v1 ()
  (id :integer :primary-key t :autoincrement t)
  (body :text)
  (:table notes))

(orm:defmodel item-v2 ()
  (id :integer :primary-key t :autoincrement t)
  (name :text :not-null t)
  (qty :integer :not-null t :default 0)
  (price :real)
  (:table items))

(orm:defmodel tag-v2 ()
  (id :integer :primary-key t :autoincrement t)
  (label :text :not-null t :unique t)
  (:table tags))

(defun snap-v1 () (orm:schema-snapshot '(item-v1 note-v1)))
(defun snap-v2 () (orm:schema-snapshot '(item-v2 tag-v2)))

(defun column-brief (c)
  (format nil "~A ~A~:[~; PK~]~:[~; AUTOINCREMENT~]~:[~; NOT NULL~]~:[~; UNIQUE~]~@[ DEFAULT ~A~]"
          (orm:column-info-name c) (orm:column-info-type c)
          (orm:column-info-primary-key c) (orm:column-info-autoincrement c)
          (orm:column-info-not-null c) (orm:column-info-unique c)
          (let ((v (orm:column-info-default c)))
            (cond ((null v) nil)
                  ((typep v 'sql-query:sql-node)
                   (values (sql-query:compile-sql v :dialect (sql-query:make-ansi-dialect))))
                  (t (prin1-to-string v))))))

(defun show-snapshot (label snapshot)
  (say "~A:" label)
  (dolist (entry snapshot)
    (say "  ~A: ~{~A~^, ~}" (car entry) (mapcar #'column-brief (cdr entry)))))

(defun op-brief (op)
  (typecase op
    (orm:alter-column-op
     (format nil "~(~A~) ~A: ~A  =>  ~A" (type-of op) (orm:schema-op-table-name op)
             (column-brief (orm:schema-op-from-column op)) (column-brief (orm:schema-op-to-column op))))
    ((or orm:add-column-op orm:drop-column-op)
     (format nil "~(~A~) ~A: ~A" (type-of op) (orm:schema-op-table-name op)
             (column-brief (orm:schema-op-column op))))
    (t (format nil "~(~A~) ~A" (type-of op) (orm:schema-op-table-name op)))))

(defun show-ops (label ops)
  (say "~A (~D op~:P):" label (length ops))
  (loop for op in ops for i from 1
        do (say "  ~D. ~A~%~A       footprint ~S" i (op-brief op) *indent* (orm:schema-op-footprint op))))

(defun rows (c sql-text)
  (sql:fetch-all (sql:execute c sql-text)))

(defun demo-orm ()
  (banner "Demo 3: sql-orm 0.2.0 (SQLite in memory)")
  (let ((v1 (snap-v1)) (v2 (snap-v2)))

    (demo-step ("3a. diff-schema :complete t, the op list, apply-ops-to-snapshot round trip")
      (show-snapshot "snapshot v1" v1)
      (show-snapshot "snapshot v2" v2)
      (show-ops "diff-schema v1 v2 (0.1 policy, :complete nil)" (orm:diff-schema v1 v2))
      (let ((ops (orm:diff-schema v1 v2 :complete t :dialect :sqlite3)))
        (show-ops "diff-schema v1 v2 :complete t :dialect :sqlite3" ops)
        (let ((folded (orm:apply-ops-to-snapshot v1 ops)))
          (show-snapshot "apply-ops-to-snapshot v1 ops" folded)
          (check "(schema-snapshot-equal folded v2 :dialect :sqlite3)"
                 (orm:schema-snapshot-equal folded v2 :dialect :sqlite3)))
        (let* ((inverse (reverse (mapcar #'orm:invert-schema-op ops)))
               (back (orm:apply-ops-to-snapshot v2 inverse)))
          (check "fold of the inverted ops from v2 = v1" (orm:schema-snapshot-equal back v1 :dialect :sqlite3)))
        (check "diff-schema v2 v2 :complete t => no ops" (null (orm:diff-schema v2 v2 :complete t)))
        (handler-case (orm:apply-ops-to-snapshot v2 ops)
          (orm:snapshot-conflict (e)
            (say "folding the same ops onto v2 signals ~A: ~A" (type-of e) e)))))

    (demo-step ("3b. alter-column-op on SQLite: table rebuild, data preserved")
      (let* ((from (find "qty" (cdr (assoc "items" v1 :test #'string-equal))
                         :key #'orm:column-info-name :test #'string-equal))
             (to (find "qty" (cdr (assoc "items" v2 :test #'string-equal))
                       :key #'orm:column-info-name :test #'string-equal))
             (op (make-instance 'orm:alter-column-op :table-name "items" :from from :to to)))
        (say "op: ~A" (op-brief op))
        (say "footprint ~S" (orm:schema-op-footprint op))
        (say "portable DDL (ANSI): ~S" (mapcar (lambda (st) (values (sql-query:compile-sql st :dialect (sql-query:make-ansi-dialect))))
                                              (orm:schema-op-upgrade op)))
        (orm:with-orm-connection (c :driver :sqlite3 :database-name ":memory:")
          (orm:upgrade-schema c (orm:diff-schema nil v1))
          (sql:execute c "INSERT INTO items (name, qty, legacy) VALUES (?, ?, ?)" '("bolt" 10 "x"))
          (sql:execute c "INSERT INTO items (name, qty, legacy) VALUES (?, ?, ?)" '("nut" 25 "y"))
          (say "rows before: ~S" (rows c "SELECT id, name, qty, legacy FROM items ORDER BY id"))
          (show-snapshot "reflect-schema before" (orm:reflect-schema c))
          (say "SQLite statements for the op: ~S"
               (mapcar (lambda (st) (if (stringp st) st (values (sql-query:compile-sql st :dialect (gethash :sqlite3 sql-query:*sql-dialect-registry*)))))
                       (orm:dialect-schema-op-statements :sqlite3 op :upgrade c)))
          (orm:upgrade-schema c (list op))
          (show-snapshot "reflect-schema after" (orm:reflect-schema c))
          (say "rows after: ~S" (rows c "SELECT id, name, qty, legacy FROM items ORDER BY id"))
          (check "live schema = (apply-ops-to-snapshot v1 (list op))"
                 (orm:schema-snapshot-equal (orm:reflect-schema c) (orm:apply-ops-to-snapshot v1 (list op))
                                            :dialect :sqlite3))
          (sql:execute c "INSERT INTO items (name) VALUES ('washer')")
          (say "insert without qty -> DEFAULT applies: ~S"
               (rows c "SELECT name, qty FROM items WHERE name = 'washer'"))
          (handler-case (progn (sql:execute c "INSERT INTO items (name, qty) VALUES ('bad', NULL)")
                               (say "NULL qty accepted  <-- UNEXPECTED"))
            (error (e) (say "NULL qty now refused: ~A" (type-of e))))
          (orm:downgrade-schema c (list op))
          (check "downgrade-schema: reflect = v1" (orm:schema-snapshot-equal (orm:reflect-schema c) v1 :dialect :sqlite3))
          (say "rows after downgrade: ~S" (rows c "SELECT id, name, qty FROM items ORDER BY id")))))

    (demo-step ("3c. alter-column to NOT NULL over existing NULLs (rebuild must fail atomically)")
      (let* ((from (find "qty" (cdr (assoc "items" v1 :test #'string-equal))
                         :key #'orm:column-info-name :test #'string-equal))
             (to (find "qty" (cdr (assoc "items" v2 :test #'string-equal))
                       :key #'orm:column-info-name :test #'string-equal))
             (op (make-instance 'orm:alter-column-op :table-name "items" :from from :to to)))
        (orm:with-orm-connection (c :driver :sqlite3 :database-name ":memory:")
          (orm:upgrade-schema c (orm:diff-schema nil v1))
          (sql:execute c "INSERT INTO items (name, qty) VALUES ('bolt', 10)")
          (sql:execute c "INSERT INTO items (name, qty) VALUES ('unknown', NULL)")
          (handler-case (progn (orm:upgrade-schema c (list op))
                               (say "upgrade-schema succeeded; rows ~S"
                                    (rows c "SELECT id, name, qty FROM items ORDER BY id")))
            (error (e) (say "upgrade-schema signalled ~A: ~A" (type-of e) e)))
          (check "schema still v1 after the failure" (orm:schema-snapshot-equal (orm:reflect-schema c) v1 :dialect :sqlite3))
          (say "rows: ~S" (rows c "SELECT id, name, qty FROM items ORDER BY id"))
          (say "tables: ~S" (mapcar (lambda (r) (getf r :name))
                                    (rows c "SELECT name FROM sqlite_master WHERE type = 'table' ORDER BY name"))))))

    (demo-step ("3d. the whole complete diff executed on SQLite; reflect-schema before/after")
      (orm:with-orm-connection (c :driver :sqlite3 :database-name ":memory:")
        (orm:upgrade-schema c (orm:diff-schema nil v1))
        (sql:execute c "INSERT INTO items (name, qty, legacy) VALUES ('bolt', 10, 'x')")
        (sql:execute c "INSERT INTO notes (body) VALUES ('hello')")
        (show-snapshot "reflect-schema before" (orm:reflect-schema c))
        (let ((ops (orm:diff-schema (orm:reflect-schema c) v2 :complete t :dialect :sqlite3)))
          (show-ops "diff-schema (reflect-schema c) v2 :complete t" ops)
          (orm:upgrade-schema c ops)
          (show-snapshot "reflect-schema after" (orm:reflect-schema c))
          (check "live = v2" (orm:schema-snapshot-equal (orm:reflect-schema c) v2 :dialect :sqlite3))
          (say "items rows: ~S" (rows c "SELECT * FROM items"))
          (orm:downgrade-schema c ops)
          (check "downgrade-schema ops: live = v1" (orm:schema-snapshot-equal (orm:reflect-schema c) v1 :dialect :sqlite3))
          (say "items rows after downgrade: ~S" (rows c "SELECT * FROM items"))
          (say "notes rows after downgrade: ~S (dropped table data is not restored)"
               (rows c "SELECT * FROM notes")))))))
