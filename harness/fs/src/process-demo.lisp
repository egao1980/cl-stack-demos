(in-package #:harness-demos-fs)

;;; Demo 2: process-protocol 0.3.0 over process-backend-uiop 0.2.0.

(defun octets (&rest bytes)
  (make-array (length bytes) :element-type '(unsigned-byte 8) :initial-contents bytes))

(defun elapsed-since (start)
  (/ (round (* 10 (- (get-internal-real-time) start)) internal-time-units-per-second) 10.0))

(defun demo-process-binary ()
  (stage "binary stdout captured as exact octets: printf '\\0\\377\\376'")
  (multiple-value-bind (code out err) (proc:run (list "printf" "\\0\\377\\376"))
    (show "exit-code" code)
    (show "stdout" out)
    (show "stdout type" (type-of out))
    (show "typep octet-vector" (typep out 'proc:octet-vector))
    (show "stderr" err))
  (stage "same bytes with :output :string → decoding refused (not silently mangled)")
  (handler-case (proc:run (list "printf" "\\0\\377\\376") :output :string)
    (proc:process-error (c)
      (show "signalled" (type-of c))
      (show "  report" (princ-to-string c))))
  (stage "string :input round trip through cat (UTF-8)")
  (multiple-value-bind (code out) (proc:run '("cat") :input "héllo, wörld" :output :string)
    (show "exit-code" code)
    (show "stdout" out)))

(defun env-of (&rest keys)
  (let ((out (nth-value 1 (apply (function proc:run) (list (posix-tool "/usr/bin/env")) :output :string keys))))
    (sort (remove "" (uiop:split-string out :separator '(#\Newline)) :test #'string=)
          #'string<)))

(defun env-value (env name)
  (let ((prefix (concatenate 'string name "=")))
    (loop for e in env
          when (uiop:string-prefix-p prefix e) return (subseq e (length prefix)))))

(defun demo-process-env ()
  (stage ":env merges into the inherited environment (default :env-mode :merge)")
  (let ((parent-home (uiop:getenv "HOME"))
        (merged (env-of :env '(("DEMO_VAR" . "added by :env")))))
    (show "parent has HOME" (and parent-home t))
    (show "child HOME = parent HOME" (equal (env-value merged "HOME") parent-home))
    (show "child DEMO_VAR" (env-value merged "DEMO_VAR"))
    (show "child variable count" (length merged)))
  (stage ":env with a NIL value unsets an inherited variable")
  (let ((unset (env-of :env '(("HOME" . nil) ("DEMO_VAR" . "x")))))
    (show "child HOME" (env-value unset "HOME"))
    (show "child DEMO_VAR" (env-value unset "DEMO_VAR")))
  (stage ":env-mode :replace gives the child exactly :env")
  (show "/usr/bin/env output" (env-of :env '(("DEMO_VAR" . "only me") "OTHER=string form")
                                      :env-mode :replace)))

(defun demo-process-cat ()
  (stage "long-lived cat driven through octet streams (launch :element-type :octets)")
  (let ((h (proc:launch '("cat") :element-type :octets)))
    (show "alive-p after launch" (proc:alive-p h))
    (show "stdin element-type" (stream-element-type (proc:stdin h)))
    (dolist (msg (list (octets 0 1 2 255 254 10) (octets 104 105 10) (octets 200 201 202 203)))
      (write-sequence msg (proc:stdin h))
      (finish-output (proc:stdin h))
      (let* ((buf (make-array (length msg) :element-type '(unsigned-byte 8)))
             (n (read-sequence buf (proc:stdout h))))
        (note "sent ~s → read ~d octets back ~s (equal: ~s)" msg n buf (equalp msg buf))))
    (show "still alive between messages" (proc:alive-p h))
    (close (proc:stdin h))
    (show "exit code after closing stdin" (proc:wait h :timeout 5))
    (show "alive-p" (proc:alive-p h))
    (show "exit-code" (proc:exit-code h))))

(defun demo-process-timeout ()
  (stage "run \"sleep 30\" with :timeout 1: CONTINUE once (wait 1 s more), then give up")
  (let ((start (get-internal-real-time))
        (continues 0)
        (handle nil))
    (handler-case
        (handler-bind ((proc:process-timeout-error
                         (lambda (c)
                           (setf handle (proc:process-timeout-error-process c))
                           (note "signalled ~a after ~as: ~a" (type-of c) (elapsed-since start)
                                 (princ-to-string c))
                           (note "restarts offered: ~s" (restart-names c))
                           (note "child alive while signalled: ~s" (proc:alive-p handle))
                           (when (< continues 1)
                             (incf continues)
                             (note "→ CONTINUE")
                             (continue c)))))
          (proc:run '("sleep" "30") :timeout 1))
      (proc:process-timeout-error (c)
        (show "unwound with" (type-of c))
        (show "  timeout slot" (proc:process-timeout-error-timeout c))
        (show "  command slot" (proc:process-error-command c))))
    (show "elapsed seconds" (elapsed-since start))
    (show "child alive-p after unwinding" (and handle (proc:alive-p handle)))
    (show "child exit-code" (and handle (proc:exit-code handle))))
  (stage "process-wait :timeout on a launched child does not kill it")
  (let ((h (proc:launch '("sleep" "30"))))
    (handler-case (proc:wait h :timeout 0.5)
      (proc:process-timeout-error (c)
        (show "signalled" (type-of c))))
    (show "alive-p after wait timeout" (proc:alive-p h))
    (if (windows-p)
        (progn
          (note "Windows: a plain kill is taskkill without /F, which console programs ignore (process-protocol's documented semantics), so :force t")
          (proc:kill h :force t))
        (proc:kill h))
    (show "exit code after kill" (proc:wait h :timeout 5))
    (show "alive-p" (proc:alive-p h))))

(defun demo-process ()
  (banner "Demo 2: process-protocol 0.4.0 / process-backend-uiop 0.3.1")
  (show "*process-backend*" proc:*process-backend*)
  (demo-process-binary)
  (demo-process-env)
  (demo-process-cat)
  (demo-process-timeout))
