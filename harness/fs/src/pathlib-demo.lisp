(in-package #:harness-demos-fs)

;;; Demo 1: cl-stack-pathlib 0.4.0 (H2a) + 0.5.0 (R4a) on the local filesystem.

(defun ascii (octets) (map 'string #'code-char octets))

(defun rel (root pathname)
  "POSIX path of PATHNAME (or a PATH) relative to ROOT."
  (let ((pn (if (pl:path-p pathname) (pl:path-pathname pathname) pathname)))
    (uiop:unix-namestring (uiop:enough-pathname pn root))))

(defun show-change (c)
  (note "~10a ~a  ~@[~a~]~:[~; -> ~]~@[~a~]"
        (pl:fs-change-kind c) (pl:fs-change-path c)
        (short (pl:fs-change-old-hash c) 15)
        (and (pl:fs-change-old-hash c) (pl:fs-change-new-hash c))
        (short (pl:fs-change-new-hash c) 15)))

(defun dir-listing (dir)
  (sort (mapcar (lambda (p) (rel dir p))
                (uiop:directory-files dir))
        #'string<))

(defun demo-pathlib-reads (root)
  (stage "fs-read-range / read-lines / content-hash")
  (let ((f (merge-pathnames "notes.txt" root)))
    (write-file f (lines "alpha" "beta" "gamma" "delta" "epsilon"))
    (show "read-range 6..10" (ascii (pl:read-range f 6 10)))
    (show "read-range 40.. (START past EOF)" (pl:read-range f 40))
    (show "read-range 28.. (to EOF)" (ascii (pl:read-range f 28)))
    (multiple-value-bind (ls more) (pl:read-lines f :start 2 :end 3)
      (show "read-lines 2..3" ls)
      (show "more-p" more))
    (multiple-value-bind (ls more) (pl:read-lines f :start 4)
      (show "read-lines 4.." ls)
      (show "more-p" more))
    (show "content-hash" (pl:content-hash f))
    (show "octets-hash of the same bytes" (pl:octets-hash (pl:read-bytes f)))
    (let ((st (pl:stat f)))
      (show "stat" st)
      (show "stat mode" (format nil "#o~o" (pl:file-stat-mode st))))))

(defun demo-pathlib-writes (root)
  (stage "atomic write, then a compare-and-swap write that loses the race")
  (let ((f (merge-pathnames "config.txt" root)))
    (multiple-value-bind (p hash written) (pl:write-text f (lines "v=1") :atomic t)
      (show "atomic write → path" (pl:as-posix p))
      (show "  hash" hash)
      (show "  written-p" written)
      (show "directory after (no temp file left)" (dir-listing root))
      ;; Someone else changes the file after we read it.
      (sh root "printf 'v=2 (other writer)\\n' > config.txt")
      (note "external writer changed config.txt; now writing with :expected-hash = our old hash")
      (multiple-value-bind (p2 hash2 written2)
          (expecting (c pl:content-hash-mismatch)
              (pl:write-text f (lines "v=3 (ours)") :expected-hash hash)
            (show "signalled" (type-of c))
            (show "  report" (princ-to-string c))
            (show "  expected" (pl:content-hash-mismatch-expected c))
            (show "  actual" (pl:content-hash-mismatch-actual c))
            (show "  restarts offered" (restart-names c))
            (note "choosing USE-CURRENT")
            (pl:invoke-use-current c))
        (show "write-text returned path" (pl:as-posix p2))
        (show "  hash (current content)" hash2)
        (show "  written-p" written2)
        (show "file content now" (read-file f)))
      (stage "create-only write with :expected-hash :absent on an existing file → overwrite restart")
      (multiple-value-bind (p3 h3 w3)
          (expecting (c pl:content-hash-mismatch)
              (pl:write-text f (lines "v=4 (forced)") :expected-hash :absent)
            (show "restarts offered" (restart-names c))
            (note "choosing OVERWRITE")
            (pl:invoke-overwrite c))
        (declare (ignore p3))
        (show "hash" h3)
        (show "written-p" w3)
        (show "file content now" (read-file f))))))

(defun demo-pathlib-ignore (root)
  (stage ".gitignore semantics: walk / glob / grep with :ignore :auto")
  (let ((tree (merge-pathnames "proj/" root)))
    (write-file (merge-pathnames ".gitignore" tree) (lines "build/" "*.log" "!keep.log" "secret.txt"))
    (write-file (merge-pathnames "src/.gitignore" tree) (lines "generated.lisp"))
    (write-file (merge-pathnames "src/main.lisp" tree) (lines "(defun main () ; TODO: args" "  :ok)"))
    (write-file (merge-pathnames "src/generated.lisp" tree) (lines ";; TODO generated, ignored"))
    (write-file (merge-pathnames "src/util.lisp" tree) (lines "(defun util () nil)" ";; todo lower-case"))
    (write-file (merge-pathnames "build/out.txt" tree) (lines "TODO in build output"))
    (write-file (merge-pathnames "app.log" tree) (lines "TODO in a log"))
    (write-file (merge-pathnames "keep.log" tree) (lines "kept log: TODO re-included"))
    (write-file (merge-pathnames "secret.txt" tree) (lines "TODO secret"))
    (write-file (merge-pathnames ".git/HEAD" tree) (lines "TODO inside .git"))
    (write-file (merge-pathnames "README.md" tree) (lines "# demo" "TODO: write docs"))
    (flet ((files-of (walk)
             (sort (loop for (nil files nil) in walk
                         append (mapcar (lambda (f) (rel tree f)) files))
                   #'string<)))
      (show "walk :ignore nil  files" (files-of (pl:walk tree)))
      (show "walk :ignore :auto files" (files-of (pl:walk tree :ignore :auto))))
    (note "rglob :ignore :auto (expected = fnmatch semantics; cl-stack-pathlib#28, fixed in 0.6.0):")
    (loop for (pattern . expected) in (quote (("*.lisp" "src/main.lisp" "src/util.lisp")
                                              ("*.l*" "keep.log" "src/main.lisp" "src/util.lisp")
                                              ("m*.lisp" "src/main.lisp")
                                              ("util.?isp" "src/util.lisp")
                                              ("[km]*" "keep.log" "src/main.lisp")))
          for got = (sort (mapcar (lambda (p) (rel tree p)) (pl:rglob tree pattern :ignore :auto))
                          (function string<))
          do (note "  ~12s → ~s~:[   MISMATCH, expected ~s~;~]" pattern got (equal got expected) expected))
    (let ((m (pl:load-ignore-files pl:*filesystem* tree)))
      (dolist (p '("build/out.txt" "app.log" "keep.log" "src/generated.lisp" "src/main.lisp"))
        (note "ignore-path-status ~20a → ~s   ignore-path-p → ~s" p
              (pl:ignore-path-status m p) (pl:ignore-path-p m p))))
    (multiple-value-bind (matches truncated) (pl:grep tree "TODO")
      (show "grep \"TODO\" (default :ignore :auto), truncated-p" truncated)
      (dolist (m matches)
        (note "~a:~d:~d: ~a" (rel tree (pl:grep-match-path m)) (pl:grep-match-line m)
              (pl:grep-match-column m) (pl:grep-match-text m))))
    (multiple-value-bind (matches truncated)
        (pl:grep tree "todo" :case-insensitive t :include "*.lisp" :max-results 1)
      (show "grep \"todo\" :case-insensitive :include \"*.lisp\" :max-results 1" matches)
      (show "  truncated-p" truncated))
    tree))

(defun demo-pathlib-snapshots (root)
  (stage "fs-snapshot / fs-snapshot-changes / fs-restore")
  (let ((tree (merge-pathnames "snap/" root))
        (store (pl:make-memory-snapshot-store)))
    (write-file (merge-pathnames "README.md" tree) (lines "hello"))
    (write-file (merge-pathnames "src/a.lisp" tree) (lines "(defun a () 1)"))
    (write-file (merge-pathnames "src/b/c.txt" tree) "")
    (let ((id1 (pl:snapshot tree :store store)))
      (show "snapshot id #1" id1)
      (dolist (e (pl:snapshot-entries id1 :store store))
        (note "entry ~s" e))
      (show "same tree again → same id" (equal id1 (pl:snapshot tree :store store)))
      ;; Change the tree: edit, add, remove, chmod +x.
      (write-file (merge-pathnames "src/a.lisp" tree) (lines "(defun a () 2)"))
      (write-file (merge-pathnames "NEW.txt" tree) (lines "new file"))
      (delete-file (merge-pathnames "src/b/c.txt" tree))
      (sh tree "chmod +x README.md")
      (let ((id2 (pl:snapshot tree :store store)))
        (show "snapshot id #2 (after edits)" id2)
        (note "snapshot-changes #1 → #2:")
        (mapc #'show-change (pl:snapshot-changes id1 id2 :store store))
        (note "restore-snapshot #1 → changes it made:")
        (mapc #'show-change (pl:restore-snapshot tree id1 :store store))
        (show "src/a.lisp after restore" (read-file (merge-pathnames "src/a.lisp" tree)))
        (show "NEW.txt exists after restore" (and (probe-file (merge-pathnames "NEW.txt" tree)) t))
        (show "src/b/c.txt exists after restore" (and (probe-file (merge-pathnames "src/b/c.txt" tree)) t))
        (show "snapshot after restore = #1" (equal id1 (pl:snapshot tree :store store)))))))

(defun demo-pathlib-area (root)
  (stage "open-area :copy, edits (pathlib + /bin/sh), area-changes, commit with a conflict")
  (let ((base (merge-pathnames "base/" root)))
    (write-file (merge-pathnames ".gitignore" base) (lines "*.tmp"))
    (write-file (merge-pathnames "app.lisp" base) (lines "(defun app () :v1)"))
    (write-file (merge-pathnames "log.txt" base) (lines "line 1"))
    (write-file (merge-pathnames "shared.txt" base) (lines "base version"))
    (write-file (merge-pathnames "scratch.tmp" base) (lines "ignored"))
    (let ((area (pl:open-area base :ignore :auto)))
      (unwind-protect
           (let ((aroot (pl:path-pathname (pl:area-root area))))
             (show "area-root" (pl:as-posix (pl:area-root area)))
             (show "area-mechanism" (pl:area-mechanism area))
             (show "area copy files (scratch.tmp ignored)" (dir-listing aroot))
             (show "manifest" (pl:area-manifest area))
             ;; Edit 1: through pathlib. Edit 2: an external process. Edit 3: new file.
             (pl:write-text (merge-pathnames "app.lisp" aroot) (lines "(defun app () :v2)"))
             (pl:write-text (merge-pathnames "shared.txt" aroot) (lines "area version"))
             (sh aroot "echo 'line 2 from /bin/sh' >> log.txt")
             (sh aroot "echo added > added.txt; echo junk > more.tmp")
             (note "area-changes (pathlib edits, a /bin/sh append, an added file; more.tmp ignored):")
             (mapc #'show-change (pl:area-changes area))
             ;; Meanwhile the base changes shared.txt too.
             (write-file (merge-pathnames "shared.txt" base) (lines "base edited after open"))
             (note "base/shared.txt edited after the area opened; committing")
             (multiple-value-bind (changes status)
                 (expecting (c pl:area-conflict)
                     (pl:close-area area :action :commit)
                   (show "signalled" (type-of c))
                   (show "  report" (princ-to-string c))
                   (show "  path" (pl:area-conflict-path c))
                   (show "  open-entry" (pl:area-conflict-open-entry c))
                   (show "  base-entry" (pl:area-conflict-base-entry c))
                   (show "  area-entry" (pl:area-conflict-area-entry c))
                   (show "  restarts offered" (restart-names c))
                   (note "choosing SKIP-PATH")
                   (pl:invoke-skip-path c))
               (show "close-area status" status)
               (note "written to the base:")
               (mapc #'show-change changes))
             (show "area-open-p" (pl:area-open-p area))
             (show "area copy deleted" (not (probe-file aroot)))
             (dolist (f '("app.lisp" "log.txt" "shared.txt" "added.txt" "scratch.tmp"))
               (show (format nil "base/~a" f)
                     (and (probe-file (merge-pathnames f base))
                          (read-file (merge-pathnames f base))))))
        (when (pl:area-open-p area)
          (pl:close-area area :action :discard))))))

(defun demo-pathlib ()
  (banner "Demo 1: cl-stack-pathlib 0.6.1 (H2a reads/writes/ignore/grep, R4a snapshots/areas)")
  (with-temp-dir (root "hd-pathlib")
    (demo-pathlib-reads root)
    (demo-pathlib-writes root)
    (demo-pathlib-ignore root)
    (demo-pathlib-snapshots root)
    (demo-pathlib-area root)))
