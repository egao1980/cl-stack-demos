(in-package #:harness-demos-fs)

;;; Demo 4: revision-backend-jj 0.2.0 on a throwaway jj repository built with jj.

(defun rfc3339 (unix)
  (multiple-value-bind (s mi h d mo y)
      (decode-universal-time (+ unix (encode-universal-time 0 0 0 1 1 1970 0)) 0)
    (format nil "~4,'0d-~2,'0d-~2,'0dT~2,'0d:~2,'0d:~2,'0d+00:00" y mo d h mi s)))

(defun jj-cli (dir env at &rest args)
  "Real jj ARGS in DIR, commit time AT, operation time AT + 5 → stdout, trimmed."
  (string-right-trim
   '(#\Newline)
   (apply #'tool dir
          (append (list (cons "JJ_TIMESTAMP" (rfc3339 at))
                        (cons "JJ_OP_TIMESTAMP" (rfc3339 (+ at 5))))
                  env)
          "jj" "--no-pager" "--color=never" args)))

(defun jj-env (home)
  (let ((env (isolated-env home)))
    (write-file (merge-pathnames "jj-config.toml" home)
                (lines "[user]" "name = \"Demo User\"" "email = \"demo@example.invalid\""))
    (append env (list (cons "JJ_EDITOR" "jj-demo-no-editor")))))

(defun build-jj-repo (dir env)
  "base → second (bookmark main); left / right on base editing a.txt; merge =
merge(left, right) committed with the conflict unresolved. → plist of change ids."
  (flet ((jj (at &rest args) (apply #'jj-cli dir env at args))
         (put (name text) (write-file (merge-pathnames name dir) text)))
    (jj +t0+ "git" "init" "--colocate" ".")
    (put "a.txt" (lines "one"))
    (put "src/lib.lisp" (lines "(defun lib () 1)"))
    (jj +t0+ "commit" "-m" "base")
    (let ((base (jj +t0+ "log" "-r" "@-" "--no-graph" "-T" "change_id")))
      (jj (+ +t0+ 10) "bookmark" "set" "main" "-r" "@-")
      (put "a.txt" (lines "one" "two"))
      (put "notes.txt" (lines "second change"))
      (jj (+ +t0+ 100) "commit" "-m" "second")
      (let ((second (jj +t0+ "log" "-r" "@-" "--no-graph" "-T" "change_id")))
        (jj (+ +t0+ 110) "bookmark" "set" "main" "-r" "@-")
        (jj (+ +t0+ 200) "new" base)
        (put "a.txt" (lines "left"))
        (jj (+ +t0+ 210) "commit" "-m" "left")
        (let ((left (jj +t0+ "log" "-r" "@-" "--no-graph" "-T" "change_id")))
          (jj (+ +t0+ 220) "new" base)
          (put "a.txt" (lines "right"))
          (jj (+ +t0+ 230) "commit" "-m" "right")
          (let ((right (jj +t0+ "log" "-r" "@-" "--no-graph" "-T" "change_id")))
            (jj (+ +t0+ 240) "new" left right)
            (jj (+ +t0+ 250) "commit" "-m" "merge left+right (conflict left in)")
            (let ((merge (jj +t0+ "log" "-r" "@-" "--no-graph" "-T" "change_id")))
              (jj (+ +t0+ 260) "new" "main")
              (list :base base :second second :left left :right right :merge merge))))))))

(defun show-jj-rev (label r)
  (note "~a change ~a commit ~a ~s parents=~s recorded=~a"
        label (short (rev:revision-id r)) (short (getf (rev:revision-provenance r) :commit-id))
        (rev:revision-message r) (mapcar #'short (rev:revision-parent-ids r))
        (dt:instant-seconds (rev:revision-recorded-at r))))

(defun demo-jj-graph (s dir env ids)
  (stage "make-jj-store")
  (show "jj-version" (jj:jj-version s))
  (show "jj-store-workspace" (jj:jj-store-workspace s))
  (show "jj-store-colocated-p" (jj:jj-store-colocated-p s))
  (show "jj-capabilities" (jj:jj-capabilities s))
  (stage "revisions: change ids (revision-id) vs commit ids (provenance :commit-id)")
  (dolist (r (rev:walk-revisions s (rev:rev-ref "main") :order :topo))
    (show-jj-rev "  main:" r))
  (show "jj log (CLI) for comparison"
        (jj-cli dir env +t0+ "log" "-r" "::main ~ root()" "--no-graph" "--ignore-working-copy"
                "-T" "change_id.short(12) ++ \" \" ++ commit_id.short(12) ++ \" \" ++ description.first_line() ++ \"\\n\""))
  (stage "commit-revision from a tree value onto main (fixed clock)")
  (let* ((tree (diff:make-tree "a.txt" (diff:make-tree-file (lines "one" "two" "three"))
                               "src" (diff:make-tree "lib.lisp" (diff:make-tree-file (lines "(defun lib () 3)")))
                               "notes.txt" (diff:make-tree-file (lines "second change"))))
         (r (dt:with-fixed-clock ((dt:make-instant (+ +t0+ 300)))
              (rev:commit-revision s tree :parents (list (rev:rev-ref "main")) :ref "main"
                                          :message "third: from a tree value"))))
    (show-jj-rev "new revision" r)
    (show "provenance" (rev:revision-provenance r))
    (setf (getf ids :third) (rev:revision-id r)))
  (stage "refs: bookmark + tag, list-refs")
  (rev:tag-revision s "v1" (getf ids :base))
  (dolist (r (rev:list-refs s))
    (note "~8a ~a → ~a" (rev:ref-kind r) (rev:ref-name r) (short (rev:ref-target r))))
  (show "merge-base left right" (rev:revision-message (rev:merge-base s (getf ids :left) (getf ids :right))))
  (show "heads" (sort (mapcar #'rev:revision-message (rev:heads s)) #'string<))
  ids)

(defun demo-jj-rewrite (s dir env ids)
  (stage "rewrite a mutable change with jj describe: same change id, new commit id")
  (let* ((before (rev:resolve-revision s (getf ids :second)))
         (old-commit (getf (rev:revision-provenance before) :commit-id))
         (op-before (jj:current-operation s)))
    (show-jj-rev "before" before)
    (jj-cli dir env (+ +t0+ 400) "describe" "-r" (getf ids :second) "-m" "second (reworded)")
    (let ((after (rev:resolve-revision s (getf ids :second))))
      (show-jj-rev "after " after)
      (show "same change id" (equal (rev:revision-id before) (rev:revision-id after)))
      (show "commit id changed" (not (equal old-commit (getf (rev:revision-provenance after) :commit-id)))))
    (show "old commit id still resolves (hidden commit)"
          (rev:revision-message (rev:resolve-revision s old-commit)))
    (stage "operation log and rev-as-of :recorded")
    (dolist (op (jj:list-operations s :limit 6))
      (note "op ~a end ~a ~s" (short (getf op :id)) (getf op :end-ms) (getf op :description)))
    (show "op before describe" (short op-before))
    (let ((d (rev:rev-as-of (dt:make-instant (+ +t0+ 350)) :on "main" :axis :recorded)))
      (show "rev-as-of t0+350 :recorded on main" (rev:revision-message (rev:resolve-revision s d))))
    (let ((d (rev:rev-as-of (dt:make-instant (+ +t0+ 120)) :on "main" :axis :recorded)))
      (show-jj-rev "rev-as-of t0+120 :recorded on main" (rev:resolve-revision s d)))
    (let ((d (rev:rev-as-of (dt:make-instant (+ +t0+ 50)) :on "main" :axis :valid)))
      (show "rev-as-of t0+50 :valid on main" (rev:revision-message (rev:resolve-revision s d))))))

(defun demo-jj-diffs (s ids)
  (stage "state-diff base → third at :summary and :content (unified)")
  (format t "~a" (diff:render-diff (rev:state-diff s (getf ids :base) (getf ids :third) :level :summary)
                                   :summary nil))
  (format t "~a" (diff:render-diff (rev:state-diff s (getf ids :base) (getf ids :third) :level :content)
                                   :unified nil)))

(defun demo-jj-conflict (s ids)
  (stage "a committed conflict: merge(left, right) with a.txt unresolved")
  (let ((m (rev:resolve-revision s (getf ids :merge))))
    (show-jj-rev "merge" m)
    (show "provenance :conflict" (getf (rev:revision-provenance m) :conflict))
    (show "revision-conflicts" (jj:revision-conflicts s (getf ids :merge)))
    (let ((p (jj:revision-path s (getf ids :merge) "/a.txt")))
      (show "read-text /a.txt @merge (materialized conflict)" (pl:read-text p)))
    (show "read-text /a.txt @left" (pl:read-text (jj:revision-path s (getf ids :left) "/a.txt")))
    (format t "~a" (diff:render-diff (rev:state-diff s (getf ids :left) (getf ids :merge) :level :content)
                                     :unified nil))))

(defun demo-jj-cas (s ids)
  (stage "CAS: move-ref main with a stale :expected → ref-conflict")
  (let ((current (rev:ref-target (rev:find-ref s "main"))))
    (show "main now" (short current))
    (show "caller believes main is" (short (getf ids :base)))
    (let ((r (expecting (c rev:ref-conflict)
                 (rev:move-ref s "main" (getf ids :left) :expected (getf ids :base))
               (show "signalled" (type-of c))
               (show "  report" (princ-to-string c))
               (show "  restarts offered" (restart-names c))
               (note "choosing USE-CURRENT")
               (invoke-restart 'rev:use-current))))
      (show "move-ref returned" (and r (short (rev:ref-target r))))
      (show "main unchanged" (equal current (rev:ref-target (rev:find-ref s "main")))))))

(defun demo-jj ()
  (banner "Demo 4: revision-backend-jj 0.2.0")
  (with-temp-dir (root "hd-jj")
    (let* ((dir (merge-pathnames "repo/" root))
           (env (jj-env (merge-pathnames "home/" root))))
      (ensure-directories-exist dir)
      (let ((ids (build-jj-repo dir env)))
        (note "built repo with jj CLI: ~s" (loop for (k v) on ids by #'cddr collect k collect (short v)))
        (let ((s (jj:make-jj-store dir :env env)))
          (setf ids (demo-jj-graph s dir env ids))
          (demo-jj-rewrite s dir env ids)
          (demo-jj-diffs s ids)
          (demo-jj-conflict s ids)
          (demo-jj-cas s ids))))))
