(in-package #:harness-demos-fs)

;;; Demo 3: revision-backend-git 0.1.0 on a throwaway repository built with git.

(defparameter +t0+ 1700000000 "Base unix time for deterministic commit dates.")

(defun git-cli (dir env at &rest args)
  "Real git ARGS in DIR with ENV and committer/author date AT → stdout, trimmed."
  (string-right-trim
   '(#\Newline)
   (apply #'tool dir
          (append (list (cons "GIT_AUTHOR_DATE" (format nil "@~d +0000" at))
                        (cons "GIT_COMMITTER_DATE" (format nil "@~d +0000" at)))
                  env)
          "git" args)))

(defun build-git-repo (dir env)
  "main: c1 → c2 → c3, feature: c1 → f1; annotated tag v1 on c1. → plist of ids."
  (flet ((g (at &rest args) (apply #'git-cli dir env at args)))
    (g +t0+ "init" "-q" "-b" "main")
    (g +t0+ "config" "commit.gpgsign" "false")
    (write-file (merge-pathnames "README.md" dir) (lines "# demo repo"))
    (write-file (merge-pathnames "src/app.lisp" dir) (lines "(defun app ()" "  :v1)"))
    (g +t0+ "add" "-A")
    (g +t0+ "commit" "-q" "-m" "c1: initial")
    (g +t0+ "tag" "-a" "v1" "-m" "first release")
    (write-file (merge-pathnames "src/app.lisp" dir) (lines "(defun app ()" "  ;; second version" "  :v2)"))
    (write-file (merge-pathnames "docs/guide.txt" dir) (lines "read me"))
    (g +t0+ "add" "-A")
    (g (+ +t0+ 100) "commit" "-q" "-m" "c2: app v2, guide")
    (g (+ +t0+ 150) "checkout" "-q" "-b" "feature" "HEAD~1")
    (write-file (merge-pathnames "feature.txt" dir) (lines "feature work"))
    (g +t0+ "add" "-A")
    (g (+ +t0+ 150) "commit" "-q" "-m" "f1: feature")
    (g +t0+ "checkout" "-q" "main")
    (g +t0+ "mv" "docs/guide.txt" "docs/manual.txt")
    (g (+ +t0+ 200) "commit" "-q" "-m" "c3: rename guide")
    (list :c1 (g +t0+ "rev-parse" "main~2") :c2 (g +t0+ "rev-parse" "main~1")
          :c3 (g +t0+ "rev-parse" "main") :f1 (g +t0+ "rev-parse" "feature"))))

(defun show-rev (label r)
  (note "~a ~a ~s parents=~s recorded=~a valid=~a"
        label (short (rev:revision-id r)) (rev:revision-message r)
        (mapcar #'short (rev:revision-parent-ids r))
        (dt:instant-seconds (rev:revision-recorded-at r))
        (and (rev:revision-valid-at r) (dt:instant-seconds (rev:revision-valid-at r)))))

(defun show-ref (r)
  (note "~8a ~a → ~a~@[  annotation ~s~]" (rev:ref-kind r) (rev:ref-name r)
        (short (rev:ref-target r)) (rev:ref-annotation r)))

(defun index-hash (dir)
  (pl:content-hash (merge-pathnames ".git/index" dir)))

(defun demo-git-graph (s ids)
  (stage "make-git-store")
  (show "git-version" (git:git-version s))
  (show "git-store-path" (native (git:git-store-path s)))
  (show "git-store-bare-p" (git:git-store-bare-p s))
  (show "content-primary" (rev:content-primary s))
  (stage "commit-revision from a tree value (fixed clock → deterministic id)")
  (let* ((tree (diff:make-tree
                "README.md" (diff:make-tree-file (lines "# demo repo" "committed from Lisp"))
                "src" (diff:make-tree "app.lisp" (diff:make-tree-file (lines "(defun app ()" "  :v4)")))
                "bin" (diff:make-tree "run.sh" (diff:make-tree-file (lines "#!/bin/sh" "echo hi")
                                                                    :mode #o100755))))
         (r (dt:with-fixed-clock ((dt:make-instant (+ +t0+ 300)))
              (rev:commit-revision s tree :ref "main" :message "c4: from a tree value"))))
    (show-rev "new revision" r)
    (show "provenance" (rev:revision-provenance r))
    (show "git log -1 --format=%H %s" (git:run-git s '("log" "-1" "--format=%H %s" "main")))
    (show "git ls-tree -r main" (git:run-git s '("ls-tree" "-r" "main")))
    (setf (getf ids :c4) (rev:revision-id r)))
  (stage "refs: move-ref (new branch), tag-revision (annotated), list-refs")
  (show-ref (rev:move-ref s "topic" (getf ids :c2) :expected nil))
  (show-ref (rev:tag-revision s "v2" (getf ids :c3) :annotation "second release"))
  (show "tag-revision again, same target + annotation (idempotent)"
        (rev:ref-target (rev:tag-revision s "v2" (getf ids :c3) :annotation "second release")))
  (let ((r (expecting (c rev:tag-immutable)
               (rev:tag-revision s "v2" (getf ids :c1))
             (show "re-tag v2 at c1 → signalled" (type-of c))
             (show "  report" (princ-to-string c))
             (show "  restarts offered" (restart-names c))
             (note "choosing CREATE-NEW-TAG \"v2-c1\"")
             (invoke-restart (quote rev:create-new-tag) "v2-c1"))))
    (show-ref r))
  (note "list-refs:")
  (mapc #'show-ref (rev:list-refs s))
  (stage "walk-revisions / merge-base / designators")
  (note "walk-revisions main :topo (parents first):")
  (dolist (r (rev:walk-revisions s (rev:rev-ref "main") :order :topo))
    (show-rev "  " r))
  (show "walk-revisions feature :until main"
        (mapcar (lambda (r) (rev:revision-message r))
                (rev:walk-revisions s (rev:rev-ref "feature") :until (rev:rev-ref "main"))))
  (let ((mb (rev:merge-base s (rev:rev-ref "main") (rev:rev-ref "feature"))))
    (show "merge-base main feature" (rev:revision-message mb))
    (show "  = c1" (equal (rev:revision-id mb) (getf ids :c1))))
  (show "ancestor-p v1 main" (rev:ancestor-p s (rev:rev-tag "v1") (rev:rev-ref "main")))
  (show "ancestor-p feature main" (rev:ancestor-p s (rev:rev-ref "feature") (rev:rev-ref "main")))
  (let ((prefix (subseq (getf ids :c2) 0 7)))
    (show (format nil "resolve-revision prefix ~s" prefix)
          (rev:revision-message (rev:resolve-revision s prefix))))
  (show "resolve-revision \"main~2\" (git revspec)"
        (rev:revision-message (rev:resolve-revision s "main~2")))
  (show "resolve (rev-parent (rev-ref \"main\"))"
        (rev:revision-message (rev:resolve-revision s (rev:rev-parent (rev:rev-ref "main")))))
  (show "resolve (rev-as-of t0+120 :on \"main\")"
        (rev:revision-message (rev:resolve-revision
                               s (rev:rev-as-of (dt:make-instant (+ +t0+ 120)) :on "main"))))
  (handler-case (rev:resolve-revision s "nope-not-a-rev")
    (rev:revision-not-found (c) (show "resolve \"nope-not-a-rev\" → signalled" (type-of c)))))

(defun demo-git-diffs (s ids)
  (stage "state-diff c2 → c3 at :summary (a pure rename)")
  (format t "~a" (diff:render-diff (rev:state-diff s (getf ids :c2) (getf ids :c3) :level :summary) :summary nil))
  (stage "state-diff c1 → c3 at :summary")
  (let ((d (rev:state-diff s (getf ids :c1) (getf ids :c3) :level :summary)))
    (show "diff-level" (diff:diff-level d))
    (show "footprint" (diff:diff-footprint d))
    (format t "~a" (diff:render-diff d :summary nil)))
  (stage "state-diff c1 → c3 at :content, rendered :unified")
  (let ((d (rev:state-diff s (getf ids :c1) (getf ids :c3) :level :content)))
    (format t "~a" (diff:render-diff d :unified nil))
    (show "delta-inverse non-NIL (reversible)" (and (rev:delta-inverse d) t))))

(defun demo-git-working-copy (s dir ids env)
  (declare (ignore ids))
  (stage "commit-revision moved the checked-out main without touching files; git reset --hard main to start clean")
  (show "git status --porcelain (stale worktree)" (git:run-git s (quote ("status" "--porcelain"))))
  (git-cli dir env +t0+ "reset" "-q" "--hard" "main")
  (stage "git-working-copy with a stamp ref: dirty, target-drift, capture-revision")
  (let ((wc (git:make-git-working-copy s :stamp-ref "refs/agent/checkpoint")))
    (rev:target-stamp wc (list (rev:revision-id (rev:resolve-revision s "HEAD"))))
    (show "target-revisions" (mapcar #'short (rev:target-revisions wc)))
    (show "drift when clean" (rev:target-drift wc s))
    ;; Dirty the worktree: edit a tracked file, add an untracked one, delete one.
    (write-file (merge-pathnames "src/app.lisp" dir) (lines "(defun app ()" "  :dirty)"))
    (write-file (merge-pathnames "notes/todo.txt" dir) (lines "untracked note"))
    (delete-file (merge-pathnames "README.md" dir))
    (sh dir "mv bin/run.sh bin/start.sh")
    (let ((status-before (git:run-git s '("status" "--porcelain")))
          (index-before (index-hash dir))
          (head-before (git:run-git s '("rev-parse" "HEAD"))))
      (show "git status --porcelain (before)" status-before)
      (let ((drift (rev:target-drift wc s)))
        (show "target-drift footprint" (diff:diff-footprint drift))
        (format t "~a" (diff:render-diff drift :summary nil)))
      (note "state-diff HEAD → working copy at :summary (rename detection on the worktree):")
      (format t "~a" (diff:render-diff (rev:state-diff s "HEAD" wc :level :summary) :summary nil))
      (let ((cap (rev:capture-revision wc s :message "agent checkpoint")))
        (show-rev "captured" cap)
        (show "refs/agent/checkpoint" (short (git:run-git s '("rev-parse" "refs/agent/checkpoint"))))
        (show "files in capture" (git:run-git s (list "ls-tree" "-r" "--name-only" (rev:revision-id cap)))))
      (show "drift after capture" (rev:target-drift wc s))
      (show "git status unchanged" (equal status-before (git:run-git s '("status" "--porcelain"))))
      (show "index file unchanged" (equal index-before (index-hash dir)))
      (show "HEAD unchanged" (equal head-before (git:run-git s '("rev-parse" "HEAD"))))
      (show "worktree file still dirty" (read-file (merge-pathnames "src/app.lisp" dir))))))

(defun demo-git-filesystem (s ids)
  (stage "read-only revision-filesystem at c1 (older than main)")
  (let* ((root (git:revision-path s (getf ids :c1) "/"))
         (fs (pl:path-filesystem root)))
    (show "revision-filesystem-revision" (short (git:revision-filesystem-revision fs)))
    (show "iterdir /" (mapcar #'pl:as-posix (pl:iterdir root)))
    (show "walk / files"
          (loop for (nil files nil) in (pl:walk root) append (mapcar #'pl:as-posix files)))
    (let ((app (git:revision-path s (getf ids :c1) "/src/app.lisp")))
      (show "read-text /src/app.lisp @c1" (pl:read-text app))
      (show "read-lines 2.. @c1" (pl:read-lines app :start 2))
      (show "content-hash @c1" (pl:content-hash app))
      (show "file-size" (pl:file-size app)))
    (show "read-text /src/app.lisp @main" (pl:read-text (git:revision-path s "main" "/src/app.lisp")))
    (show "exists-p /docs/guide.txt @c1" (pl:exists-p (git:revision-path s (getf ids :c1) "/docs/guide.txt")))
    (show "exists-p /docs/guide.txt @c2" (pl:exists-p (git:revision-path s (getf ids :c2) "/docs/guide.txt")))
    (handler-case (pl:write-text (git:revision-path s (getf ids :c1) "/new.txt") "x")
      (error (c) (show "write-text on the revision fs → signalled" (type-of c))))))

(defun demo-git-cas (s ids)
  (stage "CAS: move-ref main with a stale :expected → ref-conflict")
  (let ((stale (getf ids :c3))
        (current (rev:ref-target (rev:find-ref s "main"))))
    (show "main now" (short current))
    (show "caller believes main is" (short stale))
    (let ((r (expecting (c rev:ref-conflict)
                 (rev:move-ref s "main" (getf ids :f1) :expected stale)
               (show "signalled" (type-of c))
               (show "  report" (princ-to-string c))
               (show "  expected" (short (rev:ref-conflict-expected c)))
               (show "  actual" (short (rev:ref-conflict-actual c)))
               (show "  restarts offered" (restart-names c))
               (note "choosing USE-CURRENT")
               (invoke-restart 'rev:use-current))))
      (show "move-ref returned" (and r (short (rev:ref-target r))))
      (show "main unchanged" (equal current (rev:ref-target (rev:find-ref s "main")))))))

(defun demo-git ()
  (banner "Demo 3: revision-backend-git 0.1.0")
  (with-temp-dir (root "hd-git")
    (let* ((dir (merge-pathnames "repo/" root))
           (env (isolated-env (merge-pathnames "home/" root))))
      (ensure-directories-exist dir)
      (let ((ids (build-git-repo dir env)))
        (note "built repo with git CLI: ~s" (loop for (k v) on ids by #'cddr collect k collect (short v)))
        (git:with-git-store (s dir :env env)
          (demo-git-graph s ids)
          (setf (getf ids :c4) (rev:revision-id (rev:resolve-revision s "main")))
          (demo-git-diffs s ids)
          (demo-git-working-copy s dir ids env)
          (demo-git-filesystem s ids)
          (demo-git-cas s ids))))))
