# The reports service (python-dotenv syntax)
export APP_DATABASE__HOST=db.internal
APP_DATABASE__PORT = 5432
APP_URL=postgres://${APP_DATABASE__HOST}:${APP_DATABASE__PORT:-5432}/reports
APP_BACKUP_URL=${APP_BACKUP_HOST:-backup.internal}/reports
APP_GREETING="hello\nworld, it's \"quoted\""
APP_PEM="-----BEGIN KEY-----
MIIB
-----END KEY-----"
APP_VERBOSE=true      # a comment after a blank
APP_COLOR=#336699
APP_MAX_CONNECTIONS=8
APP_EMPTY=
APP_FLAG
